# Cloudflare Pages 응답 헤더 규칙 (빌드 시 dist 루트로 복사됨)

# 폰트·이미지·오디오는 파일명이 고정이라 장기 캐시 + immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vite가 해시를 붙인 번들도 장기 캐시
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# HTML은 항상 최신본 확인
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
