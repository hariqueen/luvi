rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 청첩장(wedding-f328e) Firestore 보안 규칙 — **형상관리 원본입니다.**
//
// 🔵 고칠 때는 이 파일을 고쳐 여기(`luvi/apps/invitation/`)서 배포하세요.
//    콘솔에서 직접 고치면 다음 배포에 덮여 사라집니다. 절차는
//    `모바일_청첩장/운영노트.md` 3-2 절 (Docker + 서비스 계정 키).
//
//    같은 내용의 사본이 옛 청첩장 저장소(`classic1/firestore.rules`,
//    github.com/hariqueen/Luvi-wedding)에도 있습니다 — 규칙이 그쪽에서 관리되던
//    시절의 흔적이라 **참고용**입니다. 그 파일을 고쳐 배포하지 마세요.
//
// 2026-08-23 실측: 웹 apiKey 로 `/invitations/{id}/guestbook`·`/guestbook`·`/rankings`
// 를 직접 읽으면 전부 403 — 아래 규칙이 실제로 적용된 상태입니다.
//
// 🔴 2026-08-17 — 클라이언트 직접 접근을 전면 차단했습니다.
//
// 이제 방명록·랭킹은 **워커 API 만** 건드립니다:
//     GET/POST /api/invitations/{invitationId}/guestbook · /rankings
// 워커는 서비스 계정(Admin SDK)으로 붙기 때문에 이 규칙을 **통째로 우회**합니다.
// 즉 아래를 전부 `if false` 로 닫아도 정상 기능은 아무것도 깨지지 않습니다.
//
// 왜 닫아야 했나 — `allow read: if true` 를 남겨두면 웹 apiKey(번들에 공개됨)로
// Firestore 를 직접 조회해 **소유자가 숨긴 글까지 읽을 수 있습니다.** 숨김 필터는
// 서버(`listGuestbook` 의 hidden 제외)에만 있어서, 직접 읽기가 열려 있는 동안은
// 숨김이 사실상 무력했습니다. 문서 형식 검증(isValidGuestbook 등)도 이제
// 워커가 합니다 — 규칙에 남겨둘 이유가 없습니다.
//
// 컬렉션 구조 (정본, 워커만 접근)
//   invitations/{invitationId}/guestbook/{auto-id}
//     · name string(1~20) · msg string(1~300) · hidden bool
//     · ipHash string(도배 판별용, 원문 IP 는 저장하지 않음) · createdAt timestamp
//   invitations/{invitationId}/rankings/{auto-id}
//     · nick string(1~20) · score number(생존 초, 소수) · caught number
//     · ipHash string · createdAt timestamp
//
// ⚠️ score 는 `+elapsed.toFixed(1)` 이라 **소수**입니다. 어디서든 정수 검사를 넣으면
//    정상 기록이 전부 거부됩니다 (docs/03-data-model.md F4).
//
// 루트 /guestbook · /rankings 는 서브컬렉션 이관 전 레거시 경로였습니다. 이관·검증이
// 끝났고 읽는 코드가 없어져 블록을 제거했습니다 — 아래 catch-all 로 차단됩니다.
// (옛 데이터 2건은 invitations/z1qo9uK3co1JzqQrjpKh/guestbook 으로 복사됨)
//
// 되돌리려면: git 이력에서 이 파일 이전 버전을 꺼내 재배포하세요.
// 배포 방법은 `모바일_청첩장/운영노트.md` 3-2 절 (Docker + 서비스 계정 키).
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // 클라이언트(웹 apiKey)로는 어떤 경로도 읽거나 쓸 수 없습니다.
    // 정상 접근 경로는 워커(Admin SDK)뿐이고, 그쪽은 규칙을 우회합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
