{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@luvi/schema": ["../../packages/schema/src/index.ts"]
    },
    // classic1 은 이 두 옵션 없이 작성된 코드입니다. 신규 코드(site·packages)에는 켜져 있고
    // 여기서만 끕니다 — 런타임 데이터화(M1) 때 코드를 정리하면서 이 두 줄을 지우세요.
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
