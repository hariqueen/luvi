# ─── 공통 ───────────────────────────────────────────────
# 값이 브라우저에 인라인되는 항목만 VITE_ 접두어를 씁니다.
# 비밀값(서비스 계정 키·카카오 REST 키)은 여기 넣지 말고 wrangler secret 으로 등록하세요.

VITE_API_BASE=http://localhost:8787/api
VITE_SITE_ORIGIN=https://luv-ai.co.kr
VITE_CDN_BASE=https://cdn.luv-ai.co.kr

# ─── Firebase (로그인·방명록·랭킹) ──────────────────────
# ⚠️ 이 6개는 전부 **브라우저에 노출되는 공개 값**입니다. apiKey 도 비밀키가 아니라
#    프로젝트 식별자입니다. 실제 보호는 (1) 승인된 도메인 (2) Firestore 보안 규칙이 합니다.
#    그래서 프로젝트가 고정인 값은 아래에 미리 적어뒀습니다.
#
# 채워야 할 것은 apiKey 하나입니다:
#   Firebase 콘솔 > 프로젝트 설정(⚙️) > 일반 > 내 앱 > wedding > SDK 설정 및 구성 > 구성
#
# 로그인을 쓰려면 콘솔에서 아래를 먼저 켜야 합니다 (안 하면 코드가 맞아도 실패):
#   Authentication > Sign-in method > 이메일/비밀번호 **사용 설정**
#   Authentication > Sign-in method > Google **사용 설정**
#   Authentication > Settings > 승인된 도메인 에 localhost · luv-ai.co.kr 추가
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=wedding-f328e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wedding-f328e
# .appspot.com 이 아니라 .firebasestorage.app 입니다 (최근 생성 프로젝트 형식)
VITE_FIREBASE_STORAGE_BUCKET=wedding-f328e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=944632084083
VITE_FIREBASE_APP_ID=1:944632084083:web:2464c1df325d559e669c06

# ─── 카카오 ─────────────────────────────────────────────
# 카카오 디벨로퍼스 > 앱 Luvi(1531156) > 플랫폼 키 > JavaScript 키
# ⚠️ 도메인을 두 곳에 등록해야 합니다 (제품 링크 관리 / JavaScript SDK 도메인).
#    두 번째를 빠뜨리면 Error 4019 로 공유 자체가 실패합니다.
VITE_KAKAO_JS_KEY=

# 카카오 로그인(OAuth)용 REST API 키 — 위 JavaScript 키와 다른 값입니다.
# 카카오 디벨로퍼스 > 카카오 로그인 > Redirect URI 에 아래를 등록하세요:
#   http://localhost:5173/login/callback/kakao
#   https://luv-ai.co.kr/login/callback/kakao
VITE_KAKAO_REST_KEY=

# ─── 네이버 로그인 ──────────────────────────────────────
# 네이버 개발자센터(developers.naver.com) > 애플리케이션 등록
# Callback URL 에 아래를 등록하세요:
#   http://localhost:5173/login/callback/naver
#   https://luv-ai.co.kr/login/callback/naver
# Client Secret 은 여기 넣지 말고 wrangler secret 으로 등록합니다.
VITE_NAVER_CLIENT_ID=

# ─── Worker 쪽 (여기 아니라 wrangler secret) ────────────
# 아래는 .env 가 아니라 Worker 시크릿입니다. 참고용으로만 적어둡니다.
#
#   wrangler secret put FIREBASE_CLIENT_EMAIL   서비스 계정 이메일
#   wrangler secret put FIREBASE_PRIVATE_KEY    서비스 계정 개인키 (PEM 전체)
#   wrangler secret put APP_SECRET              임의 문자열 32자 이상
#   wrangler secret put KAKAO_REST_KEY          위 VITE_KAKAO_REST_KEY 와 같은 값
#   wrangler secret put NAVER_CLIENT_SECRET
#
# 서비스 계정 키 받는 곳:
#   Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → JSON 다운로드
#   그 JSON 의 client_email · private_key 를 위 두 시크릿에 넣습니다.
#   🔴 JSON 파일 자체를 레포에 넣지 마세요.
