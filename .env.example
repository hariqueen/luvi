# ─── 공통 ───────────────────────────────────────────────
# 값이 브라우저에 인라인되는 항목만 VITE_ 접두어를 씁니다.
# 비밀값(서비스 계정 키·카카오 REST 키)은 여기 넣지 말고 wrangler secret 으로 등록하세요.

VITE_API_BASE=http://localhost:8787/api
VITE_SITE_ORIGIN=https://luv-ai.co.kr
VITE_CDN_BASE=https://cdn.luv-ai.co.kr

# ─── Firebase (방명록·랭킹·인증) ────────────────────────
# 청첩장 프로젝트: wedding-f328e
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=wedding-f328e
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── 카카오 ─────────────────────────────────────────────
# 카카오 디벨로퍼스 > 앱 Luvi(1531156) > 플랫폼 키 > JavaScript 키
# ⚠️ 도메인을 두 곳에 등록해야 합니다 (제품 링크 관리 / JavaScript SDK 도메인).
#    두 번째를 빠뜨리면 Error 4019 로 공유 자체가 실패합니다.
VITE_KAKAO_JS_KEY=

# 카카오 로그인(OAuth)용 REST API 키 — 위 JavaScript 키와 다른 값입니다.
# 카카오 디벨로퍼스 > 카카오 로그인 > Redirect URI 에 아래를 등록하세요:
#   http://localhost:5173/login/callback/kakao
#   https://luv-ai.co.kr/login/callback/kakao
VITE_KAKAO_REST_KEY=

# ─── 네이버 로그인 ──────────────────────────────────────
# 네이버 개발자센터(developers.naver.com) > 애플리케이션 등록
# Callback URL 에 아래를 등록하세요:
#   http://localhost:5173/login/callback/naver
#   https://luv-ai.co.kr/login/callback/naver
# Client Secret 은 여기 넣지 말고 wrangler secret 으로 등록합니다.
VITE_NAVER_CLIENT_ID=
